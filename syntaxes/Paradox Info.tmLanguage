<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Paradox Info</string>
	<key>scopeName</key>
	<string>source.paradox-info</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#heading</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#comment</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#string</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#macro-param</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#inline-math</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#script-constant</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#placeholder</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#date</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#event-id</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#value-alternatives</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#value-constant</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#value-scope</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#number</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#saved-scope</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#iterator</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#control-key</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#block-key</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#property</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#operator</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#braces</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>heading</key>
		<dict>
			<key>comment</key>
			<string>== Section == / === Section === headers used throughout the .info docs</string>
			<key>name</key>
			<string>markup.heading.paradox-info</string>
			<key>match</key>
			<string>^\x{FEFF}?\s*(={2,})([^=]+)(={2,})\s*$</string>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>punctuation.definition.heading.paradox-info</string>
				</dict>
				<key>2</key>
				<dict>
					<key>name</key>
					<string>entity.name.section.paradox-info</string>
				</dict>
				<key>3</key>
				<dict>
					<key>name</key>
					<string>punctuation.definition.heading.paradox-info</string>
				</dict>
			</dict>
		</dict>
		<key>comment</key>
		<dict>
			<key>name</key>
			<string>comment.line.number-sign.paradox</string>
			<key>match</key>
			<string>#.*$</string>
		</dict>
		<key>string</key>
		<dict>
			<key>name</key>
			<string>string.quoted.double.paradox</string>
			<key>begin</key>
			<string>"</string>
			<key>end</key>
			<string>"</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.character.escape.paradox</string>
					<key>match</key>
					<string>\\.</string>
				</dict>
				<dict>
					<key>name</key>
					<string>variable.other.substitution.paradox</string>
					<key>match</key>
					<string>\$[A-Za-z0-9_.|\-]+\$</string>
				</dict>
				<dict>
					<key>name</key>
					<string>support.function.databinding.paradox</string>
					<key>match</key>
					<string>\[[^\]]*\]</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.other.formatting.paradox</string>
					<key>match</key>
					<string>#[!A-Za-z_;]+</string>
				</dict>
			</array>
		</dict>
		<key>macro-param</key>
		<dict>
			<key>name</key>
			<string>variable.parameter.macro.paradox</string>
			<key>match</key>
			<string>\$[A-Za-z0-9_.|\-]+\$</string>
		</dict>
		<key>inline-math</key>
		<dict>
			<key>name</key>
			<string>meta.inline-math.paradox</string>
			<key>begin</key>
			<string>@\[</string>
			<key>end</key>
			<string>\]</string>
			<key>beginCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.math.begin.paradox</string>
				</dict>
			</dict>
			<key>endCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.math.end.paradox</string>
				</dict>
			</dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.numeric.paradox</string>
					<key>match</key>
					<string>-?\d+(\.\d+)?</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.arithmetic.paradox</string>
					<key>match</key>
					<string>[-+*/%()]</string>
				</dict>
				<dict>
					<key>name</key>
					<string>variable.other.constant.script.paradox</string>
					<key>match</key>
					<string>[A-Za-z_][A-Za-z0-9_]*</string>
				</dict>
			</array>
		</dict>
		<key>script-constant</key>
		<dict>
			<key>name</key>
			<string>variable.other.constant.script.paradox</string>
			<key>match</key>
			<string>@[A-Za-z_][A-Za-z0-9_]*\b</string>
		</dict>
		<key>placeholder</key>
		<dict>
			<key>comment</key>
			<string>&lt;key&gt;, &lt;triggers&gt;, &lt;scripted value&gt;… — the docs' fill-in-the-blank tokens</string>
			<key>name</key>
			<string>variable.parameter.placeholder.paradox</string>
			<key>match</key>
			<string>&lt;[A-Za-z_][A-Za-z0-9_ .|/\-]*&gt;</string>
		</dict>
		<key>date</key>
		<dict>
			<key>name</key>
			<string>constant.numeric.date.paradox</string>
			<key>match</key>
			<string>\b\d{1,4}\.\d{1,2}\.\d{1,2}(?:\.\d{1,2})?\b</string>
		</dict>
		<key>event-id</key>
		<dict>
			<key>name</key>
			<string>entity.name.function.event-id.paradox</string>
			<key>match</key>
			<string>\b[A-Za-z][A-Za-z0-9_\-]*\.\d+\b(?!\.\d)</string>
		</dict>
		<key>value-alternatives</key>
		<dict>
			<key>comment</key>
			<string>slash-separated allowed values right of =, e.g. valid_sex = all/male/female</string>
			<key>match</key>
			<string>(?&lt;==)[ \t]*([A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)+)\b</string>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>constant.language.paradox</string>
				</dict>
			</dict>
		</dict>
		<key>value-constant</key>
		<dict>
			<key>comment</key>
			<string>constants and type placeholders right of = only, so prose yes/no/all stays plain</string>
			<key>match</key>
			<string>(?&lt;==)[ \t]*(yes|no|none|all|X|int|float|bool)\b</string>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>constant.language.paradox</string>
				</dict>
			</dict>
		</dict>
		<key>value-scope</key>
		<dict>
			<key>comment</key>
			<string>scope words right of = only (exists = this, court_owner = root, …)</string>
			<key>match</key>
			<string>(?&lt;==)[ \t]*(root|this|prev(prev)*|from(from)*|liege|holder|mother|father|primary_spouse|primary_title|primary_heir|player_heir|capital_province|capital_county|capital_barony|top_liege|court_owner|employer|county|duchy|kingdom|empire|barony|province|location|culture_head|faith|culture|religion|dynasty|house|betrothed|host|killer|imprisoner|realm_priest|designated_heir|ghw_beneficiary|involved_activity|activity|activity_host|story_owner|secret_owner|secret_target|scheme_owner|scheme_target|title_province|county_controller|barony_controller|province_owner|current_travel_plan|court_position_employer|accolade_owner)\b</string>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>variable.language.scope.paradox</string>
				</dict>
			</dict>
		</dict>
		<key>number</key>
		<dict>
			<key>name</key>
			<string>constant.numeric.paradox</string>
			<key>match</key>
			<string>(?&lt;![\w.])-?\d+(\.\d+)?(?![\w.])</string>
		</dict>
		<key>saved-scope</key>
		<dict>
			<key>name</key>
			<string>variable.other.saved-scope.paradox</string>
			<key>match</key>
			<string>\b(scope|var|local_var|global_var|flag|event_target|define|list|title|character|province|culture|faith|dynasty|house|religion|trait|vassal_contract|struggle|epidemic):[A-Za-z0-9_.\-]+\b</string>
		</dict>
		<key>iterator</key>
		<dict>
			<key>name</key>
			<string>keyword.operator.iterator.paradox</string>
			<key>match</key>
			<string>\b(any|every|random|ordered)_[a-z0-9_]+\b</string>
		</dict>
		<key>control-key</key>
		<dict>
			<key>comment</key>
			<string>control words only in key position (NOT = { … }); bare if/or/not in prose stays plain</string>
			<key>name</key>
			<string>keyword.control.paradox</string>
			<key>match</key>
			<string>\b(if|else_if|else|while|switch|trigger_if|trigger_else_if|trigger_else|AND|OR|NOT|NOR|NAND|and|or|not|nor|nand|limit|alternative_limit|filter|namespace|first_valid|random_valid|triggered_desc|hidden_effect|hidden_trigger|show_as_tooltip|custom_description|custom_tooltip|calc_true_if|exists|always|save_scope_as|save_scope_value_as|save_temporary_scope_as|save_temporary_scope_value_as|clear_saved_scope|add_to_list|add_to_temporary_list|remove_from_list|is_in_list|random_list|duel|send_interface_toast|send_interface_message|trigger_event)\b(?=\s*\??=)</string>
		</dict>
		<key>block-key</key>
		<dict>
			<key>name</key>
			<string>entity.name.tag.block.paradox</string>
			<key>match</key>
			<string>\b(type|hidden|trigger|immediate|effect|option|after|potential|allow|can_pick|ai_chance|ai_will_do|ai_potential|is_shown|is_valid|is_valid_showing_failures_only|on_accept|on_decline|on_send|on_start|on_end|on_complete|on_invalidated|modifier|compare_modifier|opinion_modifier|weight|weight_multiplier|desc|title|theme|override_background|left_portrait|right_portrait|center_portrait|lower_left_portrait|lower_center_portrait|lower_right_portrait|animation|scaled_by|min|max|value|add|multiply|divide|subtract|factor|base|days|weeks|months|years|duration|target|order_by|position|chance|cost|gold|piety|prestige)\s*(?=\??=)</string>
		</dict>
		<key>property</key>
		<dict>
			<key>comment</key>
			<string>any key left of =, incl. slashed key alternatives like days/weeks/months/years =</string>
			<key>name</key>
			<string>variable.other.property.paradox</string>
			<key>match</key>
			<string>\b[A-Za-z_][A-Za-z0-9_.\-/]*\s*(?=\??=)</string>
		</dict>
		<key>operator</key>
		<dict>
			<key>name</key>
			<string>keyword.operator.comparison.paradox</string>
			<key>match</key>
			<string>(\?=|&gt;=|&lt;=|!=|==|=|&lt;|&gt;)</string>
		</dict>
		<key>braces</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>punctuation.section.block.begin.paradox</string>
					<key>match</key>
					<string>\{</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.section.block.end.paradox</string>
					<key>match</key>
					<string>\}</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.section.brackets.paradox</string>
					<key>match</key>
					<string>[\[\]]</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
