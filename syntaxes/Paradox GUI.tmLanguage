<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Paradox GUI</string>
	<key>scopeName</key>
	<string>source.paradox-gui</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#gui-keyword</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#gui-state-name</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#gui-enum</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#gui-string</string>
		</dict>
		<dict>
			<key>include</key>
			<string>source.paradox-datafunction</string>
		</dict>
		<dict>
			<key>include</key>
			<string>source.paradox</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>gui-string</key>
		<dict>
			<key>comment</key>
			<string>Double-quoted gui value with datafunction support: text = "[Character.GetName]". Declared before the core source.paradox include so its plain string rule does not swallow the [ ... ] interior.</string>
			<key>name</key>
			<string>string.quoted.double.paradox</string>
			<key>begin</key>
			<string>"</string>
			<key>end</key>
			<string>"</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>source.paradox-datafunction</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.character.escape.paradox</string>
					<key>match</key>
					<string>\\.</string>
				</dict>
				<dict>
					<key>name</key>
					<string>variable.other.substitution.paradox</string>
					<key>match</key>
					<string>\$[A-Za-z0-9_.|\-]+\$</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.other.formatting.paradox</string>
					<key>match</key>
					<string>#[!A-Za-z_;]*</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.other.icon.paradox</string>
					<key>match</key>
					<string>@[A-Za-z0-9_]+!</string>
				</dict>
			</array>
		</dict>
		<key>gui-keyword</key>
		<dict>
			<key>comment</key>
			<string>Structural declarations: template X { }, type X = base { }, types Group { }, block/blockoverride "name" { }</string>
			<key>name</key>
			<string>keyword.control.gui.paradox</string>
			<key>match</key>
			<string>\b(template|types|type|block|blockoverride|item)\b(?!\s*=)</string>
		</dict>
		<key>gui-state-name</key>
		<dict>
			<key>comment</key>
			<string>Engine state names (_show, _hide, _mouse_enter, …) used as state name = / start = / trigger targets</string>
			<key>name</key>
			<string>constant.language.state.paradox</string>
			<key>match</key>
			<string>\b_[A-Za-z0-9_]+\b</string>
		</dict>
		<key>gui-enum</key>
		<dict>
			<key>comment</key>
			<string>Fixed gui enum vocabulary (case-insensitive, matching the engine): anchors, layout policies, blend modes, sprite types, orientations. Guarded against key position.</string>
			<key>name</key>
			<string>constant.language.gui.paradox</string>
			<key>match</key>
			<string>(?i:\b(expanding|shrinking|growing|preferred|top|bottom|left|right|hcenter|vcenter|center|middle|nobaseline|vertical|horizontal|horizontal_vertical|alphamultiply|colordodge|multiply|overlay|darken|lighten|screen|mask|normal|add|corneredtiled|corneredstretched|tiled|stretched|all)\b)(?!\s*=)</string>
		</dict>
	</dict>
</dict>
</plist>
