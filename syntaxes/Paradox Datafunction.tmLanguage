<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Paradox Datafunction</string>
	<key>scopeName</key>
	<string>source.paradox-datafunction</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#expression</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>expression</key>
		<dict>
			<key>comment</key>
			<string>A [ ... ] data-function expression as used in .gui files and localization. The meta.embedded scope resets VS Code's standard token type to 'other' even when the expression sits inside a double-quoted string, which is what makes quote auto-closing and native bracket-pair colorization work inside the brackets.</string>
			<key>name</key>
			<string>meta.embedded.expression.paradox-datafunction</string>
			<key>begin</key>
			<string>\[</string>
			<key>beginCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.expression.begin.paradox-datafunction</string>
				</dict>
			</dict>
			<key>end</key>
			<string>\]</string>
			<key>endCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.expression.end.paradox-datafunction</string>
				</dict>
			</dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#inner</string>
				</dict>
			</array>
		</dict>
		<key>inner</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>comment</key>
					<string>String argument: 'localize_key' or '(int32)3'. May itself contain a bracketed expression; the begin/end machinery keeps the ] inside the quotes from ending the outer expression.</string>
					<key>name</key>
					<string>string.quoted.single.paradox-datafunction</string>
					<key>begin</key>
					<string>'</string>
					<key>end</key>
					<string>'</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>name</key>
							<string>constant.character.escape.paradox-datafunction</string>
							<key>match</key>
							<string>\\.</string>
						</dict>
						<dict>
							<key>comment</key>
							<string>Cast prefix inside string arguments: '(int32)3', '(hex)ff0000'</string>
							<key>name</key>
							<string>storage.type.cast.paradox-datafunction</string>
							<key>match</key>
							<string>^\((?i:int32|int64|uint32|uint64|float|double|bool|hex|CString|CFixedPoint)\)</string>
						</dict>
					</array>
				</dict>
				<dict>
					<key>comment</key>
					<string>Format suffix before the closing bracket: [x.GetName|U], [GetValue|2=%.0f]</string>
					<key>name</key>
					<string>constant.other.formatting.paradox-datafunction</string>
					<key>match</key>
					<string>\|[^\]']*</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>Function call name (segment directly before an opening paren)</string>
					<key>name</key>
					<string>entity.name.function.paradox-datafunction</string>
					<key>match</key>
					<string>[A-Za-z_][A-Za-z0-9_]*(?=\s*\()</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.section.arguments.begin.paradox-datafunction</string>
					<key>match</key>
					<string>\(</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.section.arguments.end.paradox-datafunction</string>
					<key>match</key>
					<string>\)</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.separator.arguments.paradox-datafunction</string>
					<key>match</key>
					<string>,</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.accessor.paradox-datafunction</string>
					<key>match</key>
					<string>\.</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.numeric.paradox-datafunction</string>
					<key>match</key>
					<string>\b\d+(?:\.\d+)?\b</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>Plain chain segment: a data type, promote or function (Character, GetPlayer, IsAlive)</string>
					<key>name</key>
					<string>support.function.datafunction.paradox-datafunction</string>
					<key>match</key>
					<string>[A-Za-z_][A-Za-z0-9_]*</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>hidden</key>
	<true/>
</dict>
</plist>
