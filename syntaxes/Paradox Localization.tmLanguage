<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Paradox Localization</string>
	<key>scopeName</key>
	<string>source.paradox-loc</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#comment</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#language-header</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#entry</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>comment</key>
		<dict>
			<key>name</key>
			<string>comment.line.number-sign.paradox-loc</string>
			<key>match</key>
			<string>#.*$</string>
		</dict>
		<key>language-header</key>
		<dict>
			<key>name</key>
			<string>keyword.control.language.paradox-loc</string>
			<key>match</key>
			<string>^\s*l_[a-z_]+:\s*$</string>
		</dict>
		<key>entry</key>
		<dict>
			<key>begin</key>
			<string>^\s*([A-Za-z0-9_.\-']+)(:)(\d*)</string>
			<key>beginCaptures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>entity.name.tag.loc-key.paradox-loc</string>
				</dict>
				<key>2</key>
				<dict>
					<key>name</key>
					<string>punctuation.separator.key-value.paradox-loc</string>
				</dict>
				<key>3</key>
				<dict>
					<key>name</key>
					<string>constant.numeric.version.paradox-loc</string>
				</dict>
			</dict>
			<key>end</key>
			<string>$</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>string.quoted.double.paradox-loc</string>
					<key>begin</key>
					<string>"</string>
					<key>end</key>
					<string>"(?=[^"]*$)</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>name</key>
							<string>constant.character.escape.paradox-loc</string>
							<key>match</key>
							<string>\\.</string>
						</dict>
						<dict>
							<key>name</key>
							<string>variable.other.substitution.paradox-loc</string>
							<key>match</key>
							<string>\$[A-Za-z0-9_.|\-]+\$</string>
						</dict>
						<dict>
							<key>include</key>
							<string>source.paradox-datafunction</string>
						</dict>
						<dict>
							<key>name</key>
							<string>constant.other.formatting.paradox-loc</string>
							<key>match</key>
							<string>#[!A-Za-z_;]*</string>
						</dict>
						<dict>
							<key>name</key>
							<string>constant.other.icon.paradox-loc</string>
							<key>match</key>
							<string>@[A-Za-z0-9_]+!</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
