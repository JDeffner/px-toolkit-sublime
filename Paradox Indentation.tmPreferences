<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>name</key><string>Paradox block indentation</string>
    <key>scope</key><string>source.paradox, source.paradox-gui, source.paradox-mod, source.paradox-info</string>
    <key>settings</key><dict>
        <key>increaseIndentPattern</key><string>^.*\{[^}]*$</string>
        <key>decreaseIndentPattern</key><string>^\s*\}</string>
    </dict>
</dict></plist>
